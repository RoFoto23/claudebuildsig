# Placeholders only. Real values go in Vercel > Project > Settings > Environment Variables. Never commit real keys.
APP_URL=https://your-domain.example
BRAND_NAME=BuildSignal
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_placeholder
SUPABASE_SECRET_KEY=placeholder-secret-key-from-supabase-dashboard
SESSION_SECRET=placeholder-random-64-hex
TOKEN_SECRET=placeholder-random-64-hex
ENC_KEY=placeholder-random-64-hex
CRON_SECRET=placeholder-random-64-hex
ADMIN_EMAILS=you@example.com
RESEND_API_KEY=placeholder
EMAIL_FROM=BuildSignal <hello@your-domain.example>
REPLY_TO=you@example.com
MAILING_ADDRESS=Business name, street, city, AZ ZIP (required by CAN-SPAM)
STRIPE_SECRET_KEY=placeholder
STRIPE_WEBHOOK_SECRET=placeholder
SAM_API_KEY=placeholder

# Forwarded-alert inbox (optional; feature ships OFF). Placeholders only: set real values in the Vercel dashboard.
# Domain that receives forwarded mail, e.g. in.example.com or <id>.resend.app (no "@")
INBOUND_DOMAIN=
# Optional AI fallback for emails the rules cannot read. Needs all of these plus a cap and prices in Admin > Sources.
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_API_KEY=placeholder
